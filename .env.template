# ==============================================================================
# AUTONOMOUS ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file defines the operational parameters for the platform.
# For production, ensure all secrets are rotated and stored in a secure vault.
# ==============================================================================

# --- [ Application Settings ] ---
# The name of the project as it appears in the UI and reports.
PROJECT_NAME="Autonomous Analytics Platform"
# The base API version path.
API_V1_STR="/api/v1"
# Environment mode: 'development', 'staging', or 'production'
ENV_MODE="development"

# --- [ Authentication & Security ] ---
# SECRET_KEY: Used for signing JWT tokens. 
# Generate a secure key: openssl rand -hex 32
SECRET_KEY="SUPER_SECRET_B2B_SAAS_KEY_CHANGE_IN_PROD"
# Hashing algorithm for JWTs (default: HS256)
ALGORITHM="HS256"
# Session duration in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- [ Database Configuration ] ---
# Connection string for PostgreSQL. 
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Local Docker Example: postgresql://user:password@db:5432/analytics
DATABASE_URL="postgresql://user:password@db:5432/analytics"
# Pool size for high-concurrency analysis runs.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- [ Redis & Celery Configuration ] ---
# Redis URL for caching and as a Celery message broker.
# Local Docker Example: redis://redis:6379/0
REDIS_URL="redis://redis:6379/0"
# Celery worker concurrency (number of parallel analysis jobs).
CELERY_WORKER_CONCURRENCY=4

# --- [ AI / LLM Provider Configuration ] ---
# Provider options: 'ollama', 'openai', 'anthropic', 'azure'
LLM_PROVIDER="ollama"
# Endpoint for the LLM API.
# Local Docker Example: http://ollama:11434
LLM_ENDPOINT="http://ollama:11434"
# The specific model to use for the Supervisor and Specialists.
LLM_MODEL="llama3"
# Temperature for generation: 0.0 for deterministic (analytics), 0.7 for creative.
LLM_TEMPERATURE=0.0

# --- [ Object Storage (Artifacts) ] ---
# S3-Compatible bucket for storing CSV/PDF reports and ML artifacts.
S3_BUCKET="analytics-artifacts"
# S3 endpoint (e.g., MinIO for local dev or AWS S3 for prod).
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_USE_SSL=False

# --- [ Operational Monitoring ] ---
# Log level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
LOG_LEVEL="INFO"
# Enable detailed audit logging for every API call.
ENABLE_AUDIT_LOGGING=True
